{
  "name": "botstryx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply botstryx --remote",
    "db:migrate:local": "wrangler d1 migrations apply botstryx --local"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.15",
    "@astryxdesign/theme-neutral": "^0.7.15",
    "@elevenlabs/react": "1.20.2",
    "@google/genai": "^3.3.0",
    "@heroicons/react": "^2.2.0",
    "@opennextjs/cloudflare": "1.20.15",
    "@stylexjs/stylex": "^0.19.2",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.15",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "4.156.0"
  }
}
