{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "botstryx",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// The site's address until a custom domain is set, plus a preview address for each uploaded version.
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		// The Worker calling itself, used by OpenNext for caching. The service name must match "name" above.
		{ "binding": "WORKER_SELF_REFERENCE", "service": "botstryx" }
	],
	"images": {
		// Next.js image optimisation, done by Cloudflare Images.
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			// Briefs from the contact form. Schema in migrations/; apply with `npm run db:migrate`.
			"binding": "DB",
			"database_name": "botstryx",
			"database_id": "47408264-e7b8-430f-98aa-8bf747d4a9ec",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			// agentLane's guard against one visitor flooding the chat: 12 messages a minute each. Counted by
			// Cloudflare at the edge, so it holds across restarts and every server. See src/app/api/lane/route.ts.
			"name": "LANE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 12, "period": 60 }
		},
		{
			// The contact form: 5 briefs a minute per visitor is plenty for a person and stops a script.
			"name": "BRIEF_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"vars": {
		// Who new-brief emails come from (a botlane.io address, verified in Resend).
		"BRIEF_NOTIFY_FROM": "Botlane <briefs@botlane.io>"
	}
	// Secrets, set with `npx wrangler secret put <NAME>`, never written here:
	//   GEMINI_API_KEY   agentLane's replies
	//   RESEND_API_KEY   sends the new-brief email
	//   BRIEF_NOTIFY_TO  who receives it (comma-separate several addresses)
}
